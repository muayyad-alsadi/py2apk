class Object: ...


class Throwable(Object): ...


class Exception(Throwable): ...


class StringBuilder(Object):
    def append(self, value: str) -> StringBuilder: ...
    def toString(self) -> str: ...


class AutoCloseable:
    def close(self) -> None: ...


class System:
    @staticmethod
    def currentTimeMillis() -> int: ...


class Thread:
    @staticmethod
    def sleep(millis: int) -> None: ...
